# Names only, empty values. Copy to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real keys.
# Supabase: Settings -> API Keys in the Supabase dashboard, or the Connect dialog.
# The secret key bypasses RLS. Server-only code reads it. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack: dashboard.paystack.com -> Settings -> API Keys & Integration Keys.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# WhatsApp Business: developers.facebook.com -> WhatsApp -> API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Public base URL of this deployment, no trailing slash. Used in the WhatsApp confirmation link.
APP_URL=

# Shared secret that the scheduler sends with every /api/jobs request.
JOBS_SECRET=